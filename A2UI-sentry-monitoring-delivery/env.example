# Frontend
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_APP_VERSION=a2ui-playground@1.0.0-local
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_LOCAL_LOG_ENDPOINT=/api/monitoring/events
VITE_API_PROXY_TARGET=http://localhost:3847

# Server
PORT=3847
MONITORING_MAX_EVENTS=5000
CORS_ORIGIN=*

# Sentry source map upload, production only.
# Do not commit real values.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
